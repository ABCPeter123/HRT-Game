{
  "manifest_version": 3,
  "name": "Vault Local Market Reader",
  "version": "0.1.0",
  "description": "Read-only Vault quote mapper with verified numeric fields and localhost-only relay.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
